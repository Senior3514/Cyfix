# Cyfix environment configuration
# Copy this file to .env.local (development) or .env (production) and adjust as needed.

# Port the Next.js server listens on
PORT=3000

# Standard Next.js environment
NODE_ENV=production

# Max time (ms) the passive scanner will wait per HTTP request before aborting
SCAN_TIMEOUT_MS=6000

# Max number of scans a single IP may trigger per minute (simple in-memory limiter)
RATE_LIMIT_MAX=5

# Optional: enables richer, model-generated explanations/remediations in
# lib/findings.ts if you wire up a real LLM call. Not required for the MVP —
# Cyfix ships with deterministic, rule-based explanations that work with no
# API key at all.
# OPENAI_API_KEY=
